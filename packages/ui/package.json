{
  "name": "@genoffice/ui",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Shared renderer UI components for the office apps (color picker, find panel, ribbon, image dialogs, icons); styling stays per-app via the shared class names",
  "exports": {
    ".": "./src/index.ts",
    "./a11y.css": "./src/a11y.css",
    "./color-picker.css": "./src/color-picker.css",
    "./dropdown.css": "./src/dropdown.css",
    "./find-panel.css": "./src/find-panel.css",
    "./fonts/*": "./src/fonts/*",
    "./image-dialogs.css": "./src/image-dialogs.css",
    "./image-viewer.css": "./src/image-viewer.css",
    "./ribbon-collapse.css": "./src/ribbon-collapse.css",
    "./screentip.css": "./src/screentip.css",
    "./tokens.css": "./src/tokens.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@genoffice/i18n": "*",
    "@genoffice/pptx-render": "*"
  }
}
