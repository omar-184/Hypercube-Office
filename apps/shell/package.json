{
  "name": "@genoffice/shell",
  "productName": "Hypercube Office",
  "version": "0.2.1",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/omar-184/Hypercube-Office",
  "private": true,
  "description": "Hypercube Office shell: one app hosting every editor behind a home/launcher window",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "notices": "node ../../tools/gen-third-party-notices.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "electron-vite build && electron .",
    "dist:mac": "npm run notices && electron-vite build && electron-builder --mac",
    "dist:win": "npm run notices && electron-vite build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@genoffice/docs": "*",
    "@genoffice/docx-engine": "*",
    "@genoffice/electron-utils": "*",
    "@genoffice/i18n": "*",
    "@genoffice/pdf-tools": "*",
    "@genoffice/pptx-engine": "*",
    "@genoffice/pptx-render": "*",
    "@genoffice/sheets": "*",
    "@genoffice/slides": "*",
    "@genoffice/ui": "*",
    "@genoffice/xlsx-gateway": "*",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "officecrypto-tool": "^0.0.19",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  },
  "author": "Hypercube Office"
}
